# gateway-go 生产环境变量模板（阿里云）
# 注入方式：SAE 环境变量 / ECS systemd EnvironmentFile / KMS 参数仓库。
# 所有 <...> 必须替换，禁止提交真实密钥。

APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

INTERNAL_TOKEN=<replace-with-32+-chars-random-token>
AI_ENGINE_BASE_URL=http://ai-engine.internal:8000
AI_ENGINE_TIMEOUT=5s

DATABASE_URL=postgres://<user>:<password>@<rds-host>:5432/<database>?sslmode=require
DB_MAX_CONNS=20

REDIS_ADDR=<redis-host>:6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0

# 前端正式域名，逗号分隔多个来源
CORS_ORIGINS=https://<your-domain>
