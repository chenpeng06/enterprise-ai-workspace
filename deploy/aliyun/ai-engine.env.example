# ai-engine-py 生产环境变量模板（阿里云）
# 注入方式：SAE 环境变量 / ECS systemd EnvironmentFile / KMS 参数仓库。
# 所有 <...> 必须替换，禁止提交真实密钥。

APP_ENV=production
APP_VERSION=1.0.0
API_PREFIX=/internal/v1
LOG_LEVEL=INFO

INTERNAL_TOKEN=<replace-with-32+-chars-random-token>

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<rds-host>:5432/<database>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<dashscope-api-key>
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=bge-reranker-v2-m3
LLM_TIMEOUT_SECONDS=60

OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=<bucket-name>
OSS_ACCESS_KEY_ID=<access-key-id>
OSS_ACCESS_KEY_SECRET=<access-key-secret>

# 容器内契约文件路径（镜像需 COPY docs/contracts）
CONTRACT_SCHEMA_PATH=/app/docs/contracts/ai-engine-internal-v1.schema.json
