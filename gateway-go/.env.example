# gateway-go 环境变量示例（复制为 .env；生产环境使用密钥管理注入）
APP_ENV=development
APP_VERSION=0.1.0
HTTP_ADDR=:8080

# SSE 代理要求写超时为 0（不限全局写超时），由代理层按事件空闲超时控制。
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

AI_ENGINE_BASE_URL=http://127.0.0.1:8000
AI_ENGINE_TIMEOUT=5s
# 内网共享密钥：生产环境必须替换，长度 >= 32。
INTERNAL_TOKEN=dev-internal-token-change-me

DATABASE_URL=postgres://workspace:workspace@127.0.0.1:5432/workspace?sslmode=disable
DB_MAX_CONNS=10

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:5173

# 本地演示租户（scripts/seed_demo.py 生成的固定 ID）
DEV_WORKSPACE_ID=0192f0e0-0001-7c2d-8e3f-0a1b2c3d4e5f
DEV_KB_ID=0192f0e0-0002-7c2d-8e3f-0a1b2c3d4e5f

# Redis 分布式令牌桶：容量 20，每秒补充 0.5 个令牌（约 30 次/分钟）
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=0.5

# 本地演示认证（生产必须关闭；密码通过环境变量覆盖）
SEED_DEMO_USERS=true
SESSION_TTL=12h
SESSION_COOKIE_SECURE=false
DEMO_SUPER_ADMIN_EMAIL=admin@demo.local
DEMO_SUPER_ADMIN_PASSWORD=Admin@12345
DEMO_ADMIN_EMAIL=ops@demo.local
DEMO_ADMIN_PASSWORD=Ops@12345
DEMO_GUEST_EMAIL=guest@demo.local
DEMO_GUEST_PASSWORD=Guest@12345
GUEST_QUOTA_DEFAULT=20

# PDF 上传目录：本地需与 ai-engine-py 的 INGEST_LOCAL_ROOT 指向同一目录
UPLOAD_DIR=../.local/uploads
UPLOAD_MAX_MB=50
