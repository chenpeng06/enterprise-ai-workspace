      }
    },
    "CitationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "data"],
      "properties": {
        "event": { "const": "citation" },
        "id": { "$ref": "#/$defs/SseEventId" },
        "data": { "$ref": "#/$defs/CitationData" }
      }
    },
    "UsageEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "data"],
      "properties": {
        "event": { "const": "usage" },
        "id": { "$ref": "#/$defs/SseEventId" },
        "data": { "$ref": "#/$defs/UsageData" }
      }
    },
    "ErrorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "data"],
      "properties": {
        "event": { "const": "error" },
        "id": { "$ref": "#/$defs/SseEventId" },
        "data": { "$ref": "#/$defs/ErrorData" }
      }
