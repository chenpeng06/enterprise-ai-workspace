# ai-engine-py 环境变量示例（复制为 .env）
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/internal/v1
LOG_LEVEL=INFO

# 内网共享密钥：生产环境必须替换且长度 >= 32
INTERNAL_TOKEN=dev-internal-token-change-me

# PostgreSQL（SQLAlchemy asyncpg 驱动；库表由 deploy/initdb/01_schema.sql 初始化）
DATABASE_URL=postgresql+asyncpg://workspace:workspace@127.0.0.1:5432/workspace
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# 模型供应商：三组凭证互相独立。
# 对话/Agent/改写可使用 DeepSeek、DashScope 或任意 OpenAI 兼容端点；
# Embedding/Rerank 需要独立供应商（DeepSeek 官方当前不提供这两个 API）。
# ---------------------------------------------------------------------------

# 默认：阿里云百炼（OpenAI 兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
CHAT_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60

# 切换到 DeepSeek 时，把上面三行改成：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-<deepseek-key>
# CHAT_MODEL=deepseek-flash        # 或 deepseek-v4-pro（更强、更贵）
# 注意：DeepSeek 只管生成；下面 Embedding 的 Key 不能复用 LLM_API_KEY。

# Embedding（1024 维，必须与 document_chunks.embedding 对齐）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# Rerank（DashScope gte-rerank 或本地 bge-reranker-v2-m3；留空表示 Phase 2 使用本地/关闭精排）
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3

# 阿里云 OSS（Phase 2 文档下载）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 可选：契约文件自定义路径；默认自动定位 <repo>/docs/contracts/
CONTRACT_SCHEMA_PATH=
